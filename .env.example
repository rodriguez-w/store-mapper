# Supabase Configuration
# Get from: https://supabase.com/dashboard
# This is the browser-safe publishable/anon key. Because it starts with
# VITE_, Vite exposes it to the frontend; protect access with Supabase RLS.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Resend API Key for email notifications.
# Do not expose a Resend secret in a VITE_ variable. Configure it as a
# server-side Supabase Edge Function secret instead.
# Get from: https://resend.com/api-keys
# RESEND_API_KEY=your-resend-api-key

# Note: Admin password is now managed via Supabase admins table
# See SECURITY_SETUP.sql for admin account configuration
